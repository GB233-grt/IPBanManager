<Window x:Class="IPBanManager.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="净域" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Margin="26">
        <Border Style="{StaticResource DialogCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="请输入" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="23,20,0,0" />
                    <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButtonStyle}"
                            Click="Cancel_Click" Margin="0,14,14,0" Width="30" Height="30" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="23,18,23,4">
                    <TextBlock x:Name="LabelText" Text="名称" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="InputBox" Style="{StaticResource ModernTextBoxStyle}" MaxLength="40" />
                    <TextBlock x:Name="ErrorText" Text="" FontSize="11.5" Foreground="{DynamicResource DangerBrush}"
                               Margin="2,7,0,0" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="22,18,22,20">
                    <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" MinWidth="88"
                            Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100"
                            Click="Confirm_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
