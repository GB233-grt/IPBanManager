<Window x:Class="IPBanManager.BatchImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量导入" Width="720" SizeToContent="Height" MaxHeight="860" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Margin="26">
        <Border Style="{StaticResource DialogCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="23,20,0,0">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="批量导入规则" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButtonStyle}"
                            Click="Cancel_Click" Margin="0,14,14,0" Width="30" Height="30" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="720">
                    <StackPanel Margin="23,18,23,6">
                        <TextBlock Text="域名列表" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="InputBox" Style="{StaticResource ModernTextBoxStyle}"
                                 Height="230" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12.5"
                                 TextChanged="InputBox_TextChanged" />
                        <TextBlock Text="每行一个域名或网址；以 # 开头的行为注释；也支持直接粘贴 HOSTS 行（如 0.0.0.0 example.com）。"
                                   Style="{StaticResource MutedText}" Margin="2,6,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="从文件读取…" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="13,7" Click="LoadFile_Click" />
                                <Button Content="清空" Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,7" Margin="8,0,0,0" Click="Clear_Click" />
                            </StackPanel>
                            <TextBlock x:Name="StatsText" Grid.Column="1" Text="等待输入"
                                       Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="导入到分组" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="GroupCombo" Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedValuePath="Id">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                                                        Background="{Binding Color, Converter={StaticResource HexBrush}}" />
                                                <TextBlock Text="{Binding Name}" Margin="7,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="导入选项" Style="{StaticResource LabelText}" />
                                <CheckBox x:Name="ExpandCheck" Style="{StaticResource ModernCheckBoxStyle}"
                                          Content="同时封禁常见子域" Checked="Option_Changed" Unchecked="Option_Changed" />
                                <CheckBox x:Name="EnabledCheck" Style="{StaticResource ModernCheckBoxStyle}"
                                          Content="导入后立即启用" IsChecked="True" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="11.5" Margin="2,12,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="22,14,22,20">
                    <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" MinWidth="88"
                            Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button Content="导入并应用" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112"
                            Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
