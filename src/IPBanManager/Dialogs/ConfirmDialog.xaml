<Window x:Class="IPBanManager.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="净域" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Margin="26">
        <Border Style="{StaticResource DialogCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="22,18,0,0">
                        <Border x:Name="TitleIconBadge" Width="30" Height="30" CornerRadius="9"
                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleIcon" Text="&#xE946;" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TitleText" Text="提示" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource IconButtonStyle}"
                            Click="Cancel_Click" Margin="0,12,14,0" Width="30" Height="30" />
                </Grid>

                <TextBlock x:Name="MessageText" Grid.Row="1" Margin="23,18,23,8" FontSize="13"
                           Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                           LineHeight="21" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="22,14,22,20">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="88" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Content="确定" Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="100" Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
