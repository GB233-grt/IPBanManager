<UserControl x:Class="IPBanManager.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="日志与备份" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="查看操作历史，恢复任意一次保存前的 HOSTS 快照" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="打开日志目录" Style="{StaticResource GhostButtonStyle}" Padding="10,8"
                        Margin="0,0,6,0" Click="OpenLogFolder_Click" />
                <Button Content="立即备份" Style="{StaticResource SecondaryButtonStyle}" Padding="13,8"
                        Margin="0,0,8,0" Click="BackupNow_Click" />
                <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Padding="13,8"
                        Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 操作日志 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="操作记录" Style="{StaticResource SectionTitleText}" />
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="7,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LogCountText" Text="0 条" FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Content="清空记录" Style="{StaticResource GhostButtonStyle}" Padding="8,5"
                                HorizontalAlignment="Right" Foreground="{DynamicResource DangerBrush}"
                                Click="ClearLogs_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <TextBox x:Name="LogSearchBox" Style="{StaticResource ModernTextBoxStyle}"
                                 Padding="32,7,10,7" TextChanged="LogSearchBox_TextChanged" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="11,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="LogSearchPlaceholder" Text="搜索操作记录…" FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="32,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="LogList" Style="{StaticResource ModernListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Top"
                                                Background="{Binding Success, Converter={StaticResource OperationSoftBrush}}">
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource OperationGlyph}}"
                                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{Binding Success, Converter={StaticResource OperationBrush}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="失败" FontSize="9.5" Margin="7,2,0,0"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           Visibility="{Binding Success, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Time, Converter={StaticResource RelativeTime}}"
                                                   FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Top" Margin="0,2,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasOperations, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无操作记录" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{Binding Operations.Count, StringFormat='共 {0} 条，最多保留 500 条'}"
                               Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- 备份 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HOSTS 备份" Style="{StaticResource SectionTitleText}" />
                            <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="7" Padding="7,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BackupCountText" Text="0 个" FontSize="10"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Content="打开目录" Style="{StaticResource GhostButtonStyle}" Padding="8,5"
                                HorizontalAlignment="Right" Click="OpenBackupFolder_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <ListBox x:Name="BackupsList" Style="{StaticResource ModernListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ModernListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8"
                                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="0,3,0,0">
                                                <Run Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SizeDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" FontSize="10"
                                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="NoBackupPanel">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="还没有备份" Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Button Content="恢复选中备份" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8" Click="Restore_Click" />
                        <TextBlock Text="恢复前会自动备份当前 HOSTS；恢复后刷新 DNS。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
