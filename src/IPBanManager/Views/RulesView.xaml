<UserControl x:Class="IPBanManager.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="规则管理" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="所有域名封禁规则都在这里，修改后按设置自动写入 HOSTS" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="13,8" Margin="0,0,10,0"
                        Click="Import_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="批量导入" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Padding="15,9" Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="添加规则" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 筛选工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="260">
                        <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBoxStyle}"
                                 Padding="34,8,12,8" TextChanged="SearchBox_TextChanged"
                                 ToolTip="搜索域名、备注或 IP" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索域名 / 备注 / IP" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="34,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <ComboBox x:Name="GroupFilter" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                              Width="148" Margin="10,0,0,0" SelectionChanged="Filter_Changed" />

                    <ComboBox x:Name="StatusFilter" Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}"
                              Width="126" Margin="10,0,0,0" SelectionChanged="Filter_Changed" SelectedIndex="0">
                        <ComboBoxItem Content="全部状态" Tag="all" />
                        <ComboBoxItem Content="仅已启用" Tag="enabled" />
                        <ComboBoxItem Content="仅已禁用" Tag="disabled" />
                    </ComboBox>

                    <ComboBox x:Name="SortFilter" Grid.Column="3" Style="{StaticResource ModernComboBoxStyle}"
                              Width="142" Margin="10,0,0,0" SelectionChanged="Filter_Changed" SelectedIndex="0">
                        <ComboBoxItem Content="最近添加" Tag="newest" />
                        <ComboBoxItem Content="域名 A → Z" Tag="domain" />
                        <ComboBoxItem Content="按分组排序" Tag="group" />
                        <ComboBoxItem Content="状态优先" Tag="status" />
                    </ComboBox>

                    <Button Grid.Column="5" Style="{StaticResource SecondaryButtonStyle}" Padding="13,8"
                            Click="ApplyHosts_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="应用 HOSTS" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,11,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FilteredText" Text="共 0 条规则" FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="·" FontSize="11.5" Margin="8,0" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="双击行可编辑，勾选方框快速启停" FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="全部启用" Style="{StaticResource GhostButtonStyle}" Padding="9,6"
                                Click="EnableVisible_Click" />
                        <Button Content="全部禁用" Style="{StaticResource GhostButtonStyle}" Padding="9,6"
                                Click="DisableVisible_Click" />
                        <Button Content="导出选中筛选结果" Style="{StaticResource GhostButtonStyle}" Padding="9,6"
                                Click="Export_Click" />
                        <Button Content="删除选中" Style="{StaticResource GhostButtonStyle}" Padding="9,6"
                                Foreground="{DynamicResource DangerBrush}" Click="DeleteSelected_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 规则表格 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,14,0,0">
            <Grid>
                <DataGrid x:Name="RulesGrid" Style="{StaticResource ModernDataGridStyle}"
                          Margin="4,4,4,4" MouseDoubleClick="RulesGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource ModernCheckBoxStyle}"
                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                              HorizontalAlignment="Center" Click="RuleEnabled_Click"
                                              ToolTip="启用 / 禁用这条规则" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="域名" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Domain}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding IpMode, StringFormat=写入模式：{0}}"
                                                   FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,2,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="目标地址" Width="170" Binding="{Binding Converter={StaticResource IpDisplay}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11.5" />
                                    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="分组" Width="112" Binding="{Binding Converter={StaticResource GroupName}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="备注" Width="1.3*" Binding="{Binding Remark}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="状态" Width="92" Binding="{Binding Converter={StaticResource RuleStatus}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11.5" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{Binding Converter={StaticResource RuleStatusBrush}}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="添加时间" Width="102" Binding="{Binding CreatedAt, Converter={StaticResource RelativeTime}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="" Width="82" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="&#xE70F;" Style="{StaticResource IconButtonStyle}"
                                                Width="28" Height="28" FontSize="12" ToolTip="编辑"
                                                Click="EditRule_Click" />
                                        <Button Content="&#xE74D;" Style="{StaticResource IconButtonStyle}"
                                                Width="28" Height="28" FontSize="12" Margin="2,0,0,0"
                                                Foreground="{DynamicResource DangerBrush}" ToolTip="删除"
                                                Click="DeleteRule_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasRules, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="还没有封禁规则" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="添加一个域名或批量导入，规则会写入 HOSTS 并刷新 DNS。" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    <Button Content="添加第一条规则" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Padding="15,8" Click="Add_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态 -->
        <Grid Grid.Row="3" Margin="2,10,2,0">
            <TextBlock Text="{Binding LastApplyDetail}" FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="720" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding BehaviorSummary}" FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
