<UserControl x:Class="IPBanManager.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="高级设置" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="HOSTS 路径、备份策略、DNS 刷新方式、模板与托盘行为" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="保存设置" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                        Margin="0,0,8,0" Click="Save_Click" />
                <Button Content="保存并应用 HOSTS" Style="{StaticResource PrimaryButtonStyle}" Padding="15,9"
                        Click="SaveAndApply_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>
                <!-- 权限 -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12"
                                Background="{DynamicResource SuccessSoftBrush}">
                            <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="运行权限" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="7" Padding="7,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PermissionText" Text="管理员" FontSize="10"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="PermissionDetail" Text="已获得写入 HOSTS 所需权限"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ElevateButton" Content="以管理员身份重启" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7" Margin="0,0,8,0" Click="Elevate_Click" />
                            <Button Content="打开数据目录" Style="{StaticResource GhostButtonStyle}"
                                    Padding="10,7" Click="OpenDataFolder_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- HOSTS 与备份 -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="HOSTS 与备份" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="修改系统 HOSTS 前会自动创建带时间戳的备份；路径可改为测试文件。"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="HOSTS 文件路径" Style="{StaticResource LabelText}" Margin="0,16,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HostsPathBox" Style="{StaticResource ModernTextBoxStyle}" />
                                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,8" Click="BrowseHosts_Click" />
                            </Grid>

                            <TextBlock Text="备份目录" Style="{StaticResource LabelText}" Margin="0,14,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BackupDirBox" Style="{StaticResource ModernTextBoxStyle}" />
                                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,8" Click="BrowseBackupDir_Click" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="备份保留数量" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="RetentionBox" Style="{StaticResource ModernTextBoxStyle}"
                                             Width="120" MaxLength="4" HorizontalAlignment="Left" />
                                </StackPanel>
                                <CheckBox x:Name="BomCheck" Grid.Column="1" Style="{StaticResource ModernCheckBoxStyle}"
                                          Content="写入 UTF-8 BOM" VerticalAlignment="Bottom" Margin="0,0,0,9"
                                          ToolTip="默认 UTF-8 无 BOM；部分旧软件可能需要 BOM" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="打开 HOSTS 目录" Style="{StaticResource GhostButtonStyle}"
                                        Padding="9,6" Click="OpenHostsFolder_Click" />
                                <Button Content="打开备份目录" Style="{StaticResource GhostButtonStyle}"
                                        Padding="9,6" Margin="6,0,0,0" Click="OpenBackupFolder_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DNS -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="DNS 刷新" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="修改 HOSTS 后自动刷新 DNS 缓存，让规则尽快生效。"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="刷新方式" Style="{StaticResource LabelText}" Margin="0,16,0,7" />
                            <ComboBox x:Name="DnsModeCombo" Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Content="自动：Windows API + ipconfig" Tag="auto" />
                                <ComboBoxItem Content="仅 Windows API" Tag="api" />
                                <ComboBoxItem Content="仅 ipconfig /flushdns" Tag="ipconfig" />
                            </ComboBox>
                            <TextBlock Text="自动模式会同时尝试 DnsFlushResolverCache 和 ipconfig /flushdns，任一成功即视为成功。"
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Button Content="测试刷新 DNS" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8" Margin="0,15,0,0" HorizontalAlignment="Left"
                                    Click="TestDns_Click" />
                            <Border Style="{StaticResource InnerCardStyle}" Margin="0,16,0,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="为什么刷新后浏览器仍能打开？" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="浏览器和系统可能有独立的 DNS/连接缓存。可关闭所有标签页、重启浏览器，或等待连接超时。HTTPS 连接不会被已建立的连接立即中断。"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 模板 -->
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="HOSTS 模板" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="使用 {domain} 代表域名，{ip} 代表目标 IP。自动写入模式会分别使用屏蔽模板和重定向模板。"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="屏蔽模板（默认 0.0.0.0）" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="BlockTemplateBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontFamily="Consolas" TextChanged="Template_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="重定向模板（默认 127.0.0.1）" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="RedirectTemplateBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontFamily="Consolas" TextChanged="Template_Changed" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="常见子域扩展前缀" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="PrefixesBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontFamily="Consolas" />
                                <TextBlock Text="逗号分隔；默认 www,m,api。扩展只会在添加规则时按需触发。"
                                           Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="示例预览" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <TextBlock x:Name="TemplatePreview" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="自动应用 HOSTS" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="添加/删除/启停规则后立即写入" Style="{StaticResource MutedText}"
                                               Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleButton x:Name="AutoApplySwitch" Style="{StaticResource ModernSwitchStyle}"
                                              HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="20,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="批量导入时默认扩展子域" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                                <ToggleButton x:Name="ExpandSwitch" Style="{StaticResource ModernSwitchStyle}"
                                              HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 托盘/自启 -->
                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="托盘与开机启动" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="托盘、开机自启和最小化行为。开机自启写入当前用户的 HKCU Run，不需要额外权限。"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid Margin="0,0,12,13">
                                    <TextBlock Text="启用托盘图标" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <ToggleButton x:Name="TraySwitch" Style="{StaticResource ModernSwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,12,13">
                                    <TextBlock Text="最小化到托盘" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <ToggleButton x:Name="MinimizeTraySwitch" Style="{StaticResource ModernSwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,12,0">
                                    <TextBlock Text="关闭到托盘" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <ToggleButton x:Name="CloseTraySwitch" Style="{StaticResource ModernSwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <Grid Margin="0,0,0,13">
                                    <TextBlock Text="开机自启" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <ToggleButton x:Name="StartSwitch" Style="{StaticResource ModernSwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="启动时最小化" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <ToggleButton x:Name="StartMinSwitch" Style="{StaticResource ModernSwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource InnerCardStyle}" Padding="12" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="数据目录" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="DataDirText" Text="" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="本工具只修改 HOSTS 文件和 DNS 缓存，不修改防火墙、不安装驱动、不修改网络适配器。HOSTS 屏蔽无法按 IP 层阻断连接，也不能拦截已经建立的 HTTPS 连接。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="8,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
