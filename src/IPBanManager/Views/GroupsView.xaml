<UserControl x:Class="IPBanManager.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="分组管理" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="把规则按场景分组，一键暂停整组；暂停不会改变组内规则自身的启用状态"
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="10,6"
                        Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GroupCount, StringFormat='{}{0} 个分组'}" FontSize="11.5"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <Button Style="{StaticResource PrimaryButtonStyle}" Padding="15,9" Click="AddGroup_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="新建分组" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>
                <ItemsControl x:Name="GroupItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Width="292" Margin="0,0,14,14" Padding="18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="12"
                                                Background="{Binding Color, Converter={StaticResource HexBrush}}">
                                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,1,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2" Style="{StaticResource ModernSwitchStyle}"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Click="GroupSwitch_Click" VerticalAlignment="Top"
                                                      ToolTip="暂停 / 恢复整个分组" />
                                    </Grid>

                                    <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" Margin="0,13,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="查看规则" Style="{StaticResource GhostButtonStyle}"
                                                Padding="8,6" HorizontalAlignment="Left" Click="ViewRules_Click" />
                                        <Button Grid.Column="1" Content="&#xE70F;" Style="{StaticResource IconButtonStyle}"
                                                Width="28" Height="28" FontSize="12" ToolTip="重命名"
                                                Click="RenameGroup_Click" />
                                        <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource IconButtonStyle}"
                                                Width="28" Height="28" FontSize="12" Margin="2,0,0,0"
                                                Foreground="{DynamicResource DangerBrush}" ToolTip="删除分组"
                                                Click="DeleteGroup_Click"
                                                Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource InnerCardStyle}" Padding="16" Margin="0,2,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                            <TextBlock Text="关于分组暂停" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="暂停一个分组后，组内规则在 HOSTS 托管区域中会被注释掉，但规则的启用状态保留。恢复分组后会按原状态重新写入。默认分组可以重命名，但不能删除。"
                                       Style="{StaticResource BodyText}" FontSize="11.5" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
