<UserControl x:Class="IPBanManager.Views.ThemeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="主题设置" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="低饱和度配色、圆角与背景图，所有改动实时预览" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="恢复默认" Style="{StaticResource GhostButtonStyle}" Padding="12,8"
                        Margin="0,0,8,0" Click="Reset_Click" />
                <Button Content="保存主题" Style="{StaticResource PrimaryButtonStyle}" Padding="15,9"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="352" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="外观模式" Style="{StaticResource SectionTitleText}" />
                            <Grid Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="深色模式" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="适合夜间使用，自动搭配深色画布和卡片" Style="{StaticResource MutedText}"
                                               Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleButton x:Name="DarkSwitch" Style="{StaticResource ModernSwitchStyle}"
                                              HorizontalAlignment="Right" Checked="DarkSwitch_Changed"
                                              Unchecked="DarkSwitch_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="强调色" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="用于按钮、选中态、导航高亮和开关" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <WrapPanel x:Name="AccentPanel" Margin="0,13,0,0">
                                <RadioButton Style="{StaticResource ColorSwatchStyle}" GroupName="AccentSwatches"
                                             Background="#4C8DFF" Tag="#4C8DFF" Margin="0,0,7,7" Checked="AccentSwatch_Checked" />
                                <RadioButton Style="{StaticResource ColorSwatchStyle}" GroupName="AccentSwatches"
                                             Background="#58B7A5" Tag="#58B7A5" Margin="0,0,7,7" Checked="AccentSwatch_Checked" />
                                <RadioButton Style="{StaticResource ColorSwatchStyle}" GroupName="AccentSwatches"
                                             Background="#FF7D9C" Tag="#FF7D9C" Margin="0,0,7,7" Checked="AccentSwatch_Checked" />
                                <RadioButton Style="{StaticResource ColorSwatchStyle}" GroupName="AccentSwatches"
                                             Background="#FF9A76" Tag="#FF9A76" Margin="0,0,7,7" Checked="AccentSwatch_Checked" />
                                <RadioButton Style="{StaticResource ColorSwatchStyle}" GroupName="AccentSwatches"
                                             Background="#B38CFF" Tag="#B38CFF" Margin="0,0,7,7" Checked="AccentSwatch_Checked" />
                                <RadioButton Style="{StaticResource ColorSwatchStyle}" GroupName="AccentSwatches"
                                             Background="#F2B84B" Tag="#F2B84B" Margin="0,0,7,7" Checked="AccentSwatch_Checked" />
                                <RadioButton Style="{StaticResource ColorSwatchStyle}" GroupName="AccentSwatches"
                                             Background="#5BA8D6" Tag="#5BA8D6" Margin="0,0,7,7" Checked="AccentSwatch_Checked" />
                                <RadioButton Style="{StaticResource ColorSwatchStyle}" GroupName="AccentSwatches"
                                             Background="#6C8CFF" Tag="#6C8CFF" Margin="0,0,7,7" Checked="AccentSwatch_Checked" />
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="自定义强调色（#RRGGBB）" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="AccentHexBox" Style="{StaticResource ModernTextBoxStyle}"
                                             Width="180" MaxLength="7" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="应用颜色" Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Bottom" Padding="12,8" Click="ApplyAccentHex_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="背景与质感" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="自定义画布底色、背景图、圆角和卡片透明度" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

                            <TextBlock Text="画布底色（#RRGGBB）" Style="{StaticResource LabelText}" Margin="0,16,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BackgroundHexBox" Style="{StaticResource ModernTextBoxStyle}"
                                         MaxLength="7" />
                                <Button Grid.Column="2" Content="应用" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,8" Click="ApplyBackgroundHex_Click" />
                            </Grid>

                            <TextBlock Text="背景图片" Style="{StaticResource LabelText}" Margin="0,16,0,7" />
                            <Border Style="{StaticResource InnerCardStyle}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="BackgroundFileText" Text="未选择背景图"
                                                   FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="支持 JPG / PNG / BMP，推荐浅色低对比图片"
                                                   Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="选择" Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,6" Click="ChooseBackground_Click" />
                                        <Button Content="清除" Style="{StaticResource GhostButtonStyle}"
                                                Padding="8,6" Margin="5,0,0,0" Click="ClearBackground_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="背景图不透明度" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="BgImageOpacityText" Grid.Column="1" Text="18%" FontSize="11.5"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Slider x:Name="BgImageOpacitySlider" Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0.03" Maximum="0.8" SmallChange="0.01" LargeChange="0.05"
                                    Margin="0,4,0,0" ValueChanged="BgImageOpacity_Changed" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="圆角强度" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="CornerValueText" Grid.Column="1" Text="14 px" FontSize="11.5"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Slider x:Name="CornerSlider" Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0" Maximum="24" SmallChange="1" LargeChange="2"
                                    Margin="0,4,0,0" ValueChanged="CornerSlider_ValueChanged" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="卡片透明度" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="96%" FontSize="11.5"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0.55" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                    Margin="0,4,0,0" ValueChanged="OpacitySlider_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="主题配置" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="导出后的 JSON 可以分享给其他设备，导入会立即应用并保存。"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <UniformGrid Columns="3" Margin="0,13,0,0">
                                <Button Content="导出主题" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,8" Margin="0,0,6,0" Click="ExportTheme_Click" />
                                <Button Content="导入主题" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,8" Margin="3,0,6,0" Click="ImportTheme_Click" />
                                <Button Content="恢复默认" Style="{StaticResource GhostButtonStyle}"
                                        Padding="10,8" Margin="6,0,0,0" Click="Reset_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 实时预览 -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="实时预览" Style="{StaticResource SectionTitleText}" />
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="8,2"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="LIVE" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </Grid>
                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="12"
                                Padding="14" Margin="0,14,0,0" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="26" Height="26" CornerRadius="8"
                                                Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="净域" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="7"
                                            Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="管理员" FontSize="9.5"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,13,0,0">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="10"
                                            Margin="0,0,5,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="正在生效" FontSize="9.5"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="128" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="10"
                                            Margin="5,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="分组" FontSize="9.5"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="5" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="11"
                                        Margin="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="7" Height="7" CornerRadius="4"
                                                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="bilibili.com" FontSize="11.5" FontWeight="SemiBold"
                                                           Margin="7,0,0,0" Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="已启用" FontSize="9.5" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource SuccessBrush}" />
                                        </Grid>
                                        <Grid Margin="0,9,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="7" Height="7" CornerRadius="4"
                                                        Background="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="weibo.com" FontSize="11.5" FontWeight="SemiBold"
                                                           Margin="7,0,0,0" Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="分组暂停" FontSize="9.5" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,11,0,0">
                                    <Button Content="应用 HOSTS" Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="10,6" FontSize="10.5" HorizontalAlignment="Left" />
                                    <Button Content="添加规则" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,6" FontSize="10.5" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="颜色、圆角、透明度会立即应用到整个界面；背景图会以低透明度铺在窗口底层。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,13,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="主题配置保存在 %APPDATA%\IPBanManager\theme.json，导出格式为可读 JSON。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="8,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
