<Window x:Class="IPBanManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="净域 - 本地 HOSTS 封禁工具"
        Width="1320" Height="860" MinWidth="780" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Icon="Assets/app-256.png"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Rectangle Fill="{DynamicResource AppBackgroundBrush}" />
        <Rectangle x:Name="BackgroundImageLayer" Opacity="0.18">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackgroundImageBrush" Stretch="UniformToFill" />
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                        <Image Source="Assets/app-256.png" Stretch="Uniform" Margin="2" />
                    </Border>
                    <TextBlock Text="净域" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,3"
                            Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HOSTS 封禁工具" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border x:Name="PreviewPill" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"
                            Padding="9,4" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="预览模式" FontSize="11" Margin="5,0,0,0"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="AdminPill" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="9"
                            Padding="9,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AdminPillIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                       FontSize="10" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AdminPillText" Text="管理员" FontSize="11" Margin="5,0,0,0"
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE921;" ToolTip="最小化" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE922;" ToolTip="最大化" Click="MaximizeButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarButtonStyle}" Tag="close"
                            Content="&#xE8BB;" ToolTip="关闭" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- 主区域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" Background="{DynamicResource NavBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0">
                    <Grid Margin="0,12,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="总览" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="26,4,0,6" />
                                <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}"
                                             GroupName="Nav" Tag="dashboard" IsChecked="True" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="首页" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock Text="规则" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="26,18,0,6" />
                                <RadioButton x:Name="NavRules" Style="{StaticResource NavButtonStyle}"
                                             GroupName="Nav" Tag="rules" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="规则管理" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavGroups" Style="{StaticResource NavButtonStyle}"
                                             GroupName="Nav" Tag="groups" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="分组管理" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock Text="个性化与系统" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="26,18,0,6" />
                                <RadioButton x:Name="NavTheme" Style="{StaticResource NavButtonStyle}"
                                             GroupName="Nav" Tag="theme" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="主题设置" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavButtonStyle}"
                                             GroupName="Nav" Tag="advanced" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="高级设置" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavLogs" Style="{StaticResource NavButtonStyle}"
                                             GroupName="Nav" Tag="logs" Click="Nav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="日志与备份" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="14,10,14,0">
                            <Border Style="{StaticResource InnerCardStyle}" Padding="11">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}"
                                                VerticalAlignment="Center" />
                                        <TextBlock x:Name="SideStatusText" Text="保护运行中" FontSize="11.5" Margin="7,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="SideHostsText" Text="HOSTS 已连接" FontSize="10.5" Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="净域 v1.0.0" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="4,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右侧内容 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="AdminBanner" Grid.Row="0" Margin="28,12,28,0"
                            Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="13,9"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="当前没有管理员权限" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="写入系统 HOSTS 需要管理员权限，可以查看规则但无法保存。" FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="以管理员身份重启" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,6" Click="ElevateButton_Click" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="&#xE8BB;" Style="{StaticResource IconButtonStyle}"
                                    Click="DismissAdminBanner_Click" Width="30" Height="30" Margin="4,0,0,0"
                                    VerticalAlignment="Center" ToolTip="暂时忽略" />
                        </Grid>
                    </Border>

                    <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageTransform" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>

        <!-- Toast -->
        <Border x:Name="ToastBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,26" MaxWidth="540" Background="{DynamicResource SurfaceSolidBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ControlRadius}" Padding="14,11"
                Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#0E1624" BlurRadius="26" ShadowDepth="6" Direction="270"
                                  Opacity="0.22" RenderingBias="Quality" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="12" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="ToastIconBadge" Width="26" Height="26" CornerRadius="8"
                        Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                               FontSize="12" Foreground="{DynamicResource SuccessBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ToastText" Margin="10,1,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" MaxWidth="470" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
