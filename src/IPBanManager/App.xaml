<Application x:Class="IPBanManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IPBanManager.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <conv:IpDisplayConverter x:Key="IpDisplay" />
            <conv:GroupNameConverter x:Key="GroupName" />
            <conv:RuleStatusConverter x:Key="RuleStatus" />
            <conv:RuleStatusBrushConverter x:Key="RuleStatusBrush" />
            <conv:RelativeTimeConverter x:Key="RelativeTime" />
            <conv:HexBrushConverter x:Key="HexBrush" />
            <conv:OperationGlyphConverter x:Key="OperationGlyph" />
            <conv:OperationBrushConverter x:Key="OperationBrush" />
            <conv:OperationSoftBrushConverter x:Key="OperationSoftBrush" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
